# SaaS Product Analytics Platform — stack configuration
# No secrets here — safe to commit. Override in .env.local if needed.

# --- PostgreSQL (operational source-of-truth) ---
POSTGRES_VERSION=16
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas
POSTGRES_DB=saas

# --- Simulation ---
# Deterministic random seed: same SEED => identical 24-month history.
SEED=42

# --- ClickHouse (analytical warehouse) ---
CLICKHOUSE_VERSION=25.3
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=analytics
# dlt writes raw source-aligned data into this ClickHouse database (bronze).
BRONZE_DB=bronze

# Dedicated read-only ClickHouse user for the Evidence report (Evidence
# requires a non-empty password; the stack init scripts create this user).
EVIDENCE_CLICKHOUSE_USER=evidence
EVIDENCE_CLICKHOUSE_PASSWORD=evidence

# --- dbt ---
DBT_CLICKHOUSE_VERSION=1.10.2
DBT_CORE_VERSION=1.10.23
DBT_TARGET=dev

# --- Airflow ---
AIRFLOW_VERSION=2.9.3
